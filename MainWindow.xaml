<Window x:Class="InstaDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:l="clr-namespace:InstaDesktop.Localization"
 Title="InstaDesktop" Icon="Assets/Icons/app.ico" Width="1200" Height="800" MinWidth="760" MinHeight="600"
 WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource AppBackground}" UseLayoutRounding="True"
 Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing"
 StateChanged="Window_StateChanged" IsVisibleChanged="Window_IsVisibleChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource Outline}" BorderThickness="1">
 <Grid x:Name="ShellRoot">
  <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1">
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
     <Image Source="Assets/Icons/app.ico" Width="22" Height="22" Stretch="Uniform" />
     <TextBlock Text="Instagram" Style="{StaticResource BrandWordmark}" />
     <Button x:Name="TitleSettingsButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="12,0,0,0" ToolTip="{l:T Main.Settings}" AutomationProperties.Name="{l:T Settings.Title}" Click="Settings_Click"><Path Data="M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5,5 L7,7 M17,17 L19,19 M5,19 L7,17 M17,7 L19,5 M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7" Style="{StaticResource LineIcon}" Width="17" Height="17" /></Button>
     <Button x:Name="MessagesWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="2,0,0,0" ToolTip="{l:T Main.MessagesWindow}" AutomationProperties.Name="{l:T Tray.MessagesWindow}" Click="MessagesWindow_Click"><Path Data="M4,4 H20 V16 H9 L4,20 Z M8,8.5 H16 M8,12 H13" Style="{StaticResource LineIcon}" Width="17" Height="17" /></Button>
     <Button x:Name="ZoomButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Width="Auto" MinWidth="44" Height="26" Padding="8,0" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="{l:T Main.ResetZoom}" AutomationProperties.Name="{l:T Main.ResetZoom}" Click="ZoomReset_Click"><TextBlock x:Name="ZoomText" Text="100%" FontSize="12" Foreground="{DynamicResource SecondaryText}" /></Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Style="{StaticResource IconButton}" Width="44" Height="39" ToolTip="{l:T Main.Minimize}" AutomationProperties.Name="{l:T Main.Minimize}" Click="Minimize_Click"><Path Data="M0,5 H10" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1" /></Button>
     <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Width="44" Height="39" ToolTip="{l:T Main.Maximize}" AutomationProperties.Name="{l:T Main.Maximize}" Click="Maximize_Click"><Path x:Name="MaximizeIcon" Data="M0,0 H10 V10 H0 Z" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1" /></Button>
     <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="44" Height="39" ToolTip="{l:T Main.Close}" AutomationProperties.Name="{l:T Main.Close}" Click="Close_Click"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.2" /></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" x:Name="WebContent" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
   <Grid x:Name="BrowserHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
   <Border x:Name="StatusPanel" Background="{DynamicResource AppBackground}" Visibility="Collapsed">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Margin="32">
     <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Surface}" HorizontalAlignment="Center" Margin="0,0,0,24"><Image Source="Assets/Icons/app.ico" Width="36" Height="36" Stretch="Uniform" /></Border>
     <TextBlock x:Name="StatusHeading" Text="{l:T Main.Heading}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10" />
     <TextBlock x:Name="StatusText" Text="{l:T Main.Loading}" Foreground="{DynamicResource SecondaryText}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
     <StackPanel x:Name="RecoveryActions" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0"><Button Content="{l:T Main.Retry}" Click="Reload_Click" Margin="0,0,8,0" /><Button x:Name="RuntimeButton" Content="{l:T Main.GetRuntime}" Click="Runtime_Click" Visibility="Collapsed" /></StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
 </Border>
</Window>
