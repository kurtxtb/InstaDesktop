<Window x:Class="InstaDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:InstaDesktop.Localization"
        Title="{l:T Settings.WindowTitle}" Icon="Assets/Icons/app.ico" Width="620" Height="760" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource AppBackground}" Closing="Window_Closing">
    <Window.Resources>
        <!-- Section caption above a card -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,24,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,6" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style x:Key="SettingRow" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1877F2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#0064C8" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10" />
        </Style>
        <!-- Slim vertical scrollbar (this window never scrolls horizontally) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,6">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource ScrollThumb}" />
                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHover}" /></Trigger></ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1" Padding="28,20">
            <DockPanel>
                <Image Source="Assets/Icons/app.ico" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T Settings.Title}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft JhengHei UI" />
                    <TextBlock x:Name="VersionText" Text="InstaDesktop" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,24">
            <StackPanel>
                <!-- General -->
                <TextBlock Text="{l:T Section.General}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="StartupCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T General.Startup}">
                            <StackPanel>
                                <TextBlock Text="{l:T General.Startup}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T General.StartupHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource ChoiceRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:T General.CloseButton}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T General.CloseButtonHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <ComboBox x:Name="CloseBehaviorCombo" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{l:T General.CloseButton}">
                                <ComboBoxItem Content="{l:T General.MinimizeToTray}" /><ComboBoxItem Content="{l:T General.ExitApplication}" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource ChoiceRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:T General.Appearance}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T General.AppearanceHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{l:T General.Appearance}">
                                <ComboBoxItem Content="{l:T General.ThemeSystem}" /><ComboBoxItem Content="{l:T General.ThemeDark}" /><ComboBoxItem Content="{l:T General.ThemeLight}" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource ChoiceRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:T General.Language}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T General.LanguageHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{l:T General.Language}">
                                <ComboBoxItem Content="{l:T General.LanguageSystem}" /><ComboBoxItem Content="English" /><ComboBoxItem Content="繁體中文" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <TextBlock Text="{l:T Section.Notifications}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AppNotificationsCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Notif.Desktop}">
                            <StackPanel>
                                <TextBlock Text="{l:T Notif.Desktop}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Notif.DesktopHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="NotificationSoundCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Notif.Sound}"
                                  IsEnabled="{Binding IsChecked, ElementName=AppNotificationsCheck}">
                            <StackPanel>
                                <TextBlock Text="{l:T Notif.Sound}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Notif.SoundHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="HideContentCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Notif.HideContent}"
                                  IsEnabled="{Binding IsChecked, ElementName=AppNotificationsCheck}">
                            <StackPanel>
                                <TextBlock Text="{l:T Notif.HideContent}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Notif.HideContentHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="FlashCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Notif.Flash}">
                            <StackPanel>
                                <TextBlock Text="{l:T Notif.Flash}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Notif.FlashHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="UnreadBadgeCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Notif.Badge}">
                            <StackPanel>
                                <TextBlock Text="{l:T Notif.Badge}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Notif.BadgeHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <DockPanel Margin="0,12,0,8">
                            <Button x:Name="UnmuteAllButton" DockPanel.Dock="Right" Content="{l:T Notif.UnmuteAll}" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="UnmuteAll_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T Notif.Muted}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="MutedText" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Calls -->
                <TextBlock Text="{l:T Section.Calls}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource RowHint}" Text="{l:T Calls.Intro}" />
                        <CheckBox x:Name="MicrophoneCheck" Style="{StaticResource SettingRow}" Checked="MediaCheck_Changed" Unchecked="MediaCheck_Changed" AutomationProperties.Name="{l:T Calls.Microphone}">
                            <StackPanel>
                                <TextBlock Text="{l:T Calls.Microphone}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="MicrophoneState" Style="{StaticResource RowHint}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="CameraCheck" Style="{StaticResource SettingRow}" Checked="MediaCheck_Changed" Unchecked="MediaCheck_Changed" AutomationProperties.Name="{l:T Calls.Camera}">
                            <StackPanel>
                                <TextBlock Text="{l:T Calls.Camera}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="CameraState" Style="{StaticResource RowHint}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="CallOnTopCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Calls.OnTop}">
                            <StackPanel>
                                <TextBlock Text="{l:T Calls.OnTop}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Calls.OnTopHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <TextBlock Margin="0,10,0,8" Style="{StaticResource RowHint}" Text="{l:T Calls.WindowsPrivacy}" />
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="{l:T Calls.MicrophonePrivacy}" Style="{StaticResource LinkButton}" Click="MicrophonePrivacy_Click" />
                            <Button Content="{l:T Calls.CameraPrivacy}" Style="{StaticResource LinkButton}" Click="CameraPrivacy_Click" />
                            <Button Content="{l:T Calls.ResetPermissions}" Style="{StaticResource LinkButton}" Click="Permissions_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Downloads -->
                <TextBlock Text="{l:T Section.Downloads}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Margin="0,12,0,6">
                            <TextBlock Text="{l:T Downloads.Folder}" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="DownloadFolderText" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <WrapPanel Margin="0,4,0,4">
                            <Button Content="{l:T Downloads.Change}" Style="{StaticResource LinkButton}" Click="ChangeDownloadFolder_Click" />
                            <Button Content="{l:T Downloads.Open}" Style="{StaticResource LinkButton}" Click="OpenDownloadFolder_Click" />
                            <Button x:Name="ResetDownloadFolderButton" Content="{l:T Downloads.Reset}" Style="{StaticResource LinkButton}" Click="ResetDownloadFolder_Click" />
                        </WrapPanel>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="AskDownloadCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Downloads.Ask}">
                            <StackPanel>
                                <TextBlock Text="{l:T Downloads.Ask}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Downloads.AskHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <TextBlock Text="{l:T Section.Updates}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Updates.Auto}">
                            <StackPanel>
                                <TextBlock Text="{l:T Updates.Auto}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Updates.AutoHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <DockPanel Margin="0,12,0,4">
                            <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Left" Content="{l:T Updates.Check}" Style="{StaticResource LinkButton}" Click="CheckUpdates_Click" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowHint}" VerticalAlignment="Center" Margin="4,0,0,8" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Performance -->
                <TextBlock Text="{l:T Section.Performance}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="LowMemoryCheck" AutomationProperties.Name="{l:T Perf.LowMemory}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource SettingRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AppNotificationsCheck}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                            <StackPanel>
                                <TextBlock Text="{l:T Perf.LowMemory}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Perf.LowMemoryHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="HardwareCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Perf.Hardware}">
                            <StackPanel>
                                <TextBlock Text="{l:T Perf.Hardware}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Perf.HardwareHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <TextBlock Text="{l:T Section.Advanced}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="DevToolsCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="{l:T Adv.DevTools}">
                            <StackPanel>
                                <TextBlock Text="{l:T Adv.DevTools}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:T Adv.DevToolsHint}" Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <TextBlock Margin="0,12,0,8" Style="{StaticResource RowHint}" Text="{l:T Adv.ClearCacheHint}" />
                        <WrapPanel Margin="0,0,0,4">
                            <Button x:Name="ClearCacheButton" Content="{l:T Adv.ClearCache}" Style="{StaticResource LinkButton}" Click="ClearCache_Click" />
                            <Button Content="{l:T Adv.OpenLogs}" Style="{StaticResource LinkButton}" Click="Logs_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="{l:T Settings.Cancel}" Click="Cancel_Click" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="{l:T Settings.Save}" Click="Save_Click" IsDefault="True" MinWidth="100" Style="{StaticResource AccentButton}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
