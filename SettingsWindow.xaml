<Window x:Class="InstaDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InstaDesktop Settings" Icon="Assets/Icons/app.ico" Width="620" Height="760" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{StaticResource AppBackground}" Closing="Window_Closing">
    <Window.Resources>
        <!-- Section caption above a card -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,24,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#121214" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,6" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource Outline}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style x:Key="SettingRow" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1877F2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#0064C8" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Slim dark vertical scrollbar (this window never scrolls horizontally) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,6">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border x:Name="Bar" CornerRadius="3" Background="#3A3A3C" />
                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#5A5A5E" /></Trigger></ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1" Padding="28,20">
            <DockPanel>
                <Image Source="Assets/Icons/app.ico" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <TextBlock x:Name="VersionText" Text="InstaDesktop" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,24">
            <StackPanel>
                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="StartupCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="Start with Windows">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Opens quietly in the tray when you sign in." Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Close button" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="What the window's X button does." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <ComboBox x:Name="CloseBehaviorCombo" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Close button behavior">
                                <ComboBoxItem Content="Minimize to tray" /><ComboBoxItem Content="Exit application" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <TextBlock Text="Notifications" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="AppNotificationsCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="Desktop notifications">
                        <StackPanel>
                            <TextBlock Text="Desktop notifications" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Shows Instagram's messages and alerts as Windows notifications, even from the tray." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- Calls -->
                <TextBlock Text="Calls" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource RowHint}"
                                   Text="Calls open in their own window. When a switch is on, Instagram can ask for the device and InstaDesktop asks you before the first use. Turning it off blocks requests and stops any use in progress immediately." />
                        <CheckBox x:Name="MicrophoneCheck" Style="{StaticResource SettingRow}" Checked="MediaCheck_Changed" Unchecked="MediaCheck_Changed" AutomationProperties.Name="Allow microphone">
                            <StackPanel>
                                <TextBlock Text="Allow microphone" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="MicrophoneState" Style="{StaticResource RowHint}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="CameraCheck" Style="{StaticResource SettingRow}" Checked="MediaCheck_Changed" Unchecked="MediaCheck_Changed" AutomationProperties.Name="Allow camera">
                            <StackPanel>
                                <TextBlock Text="Allow camera" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="CameraState" Style="{StaticResource RowHint}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <TextBlock Margin="0,10,0,8" Style="{StaticResource RowHint}"
                                   Text="Windows must also let desktop apps use them: Privacy &amp; security &gt; Microphone / Camera &gt; Let desktop apps access." />
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Microphone privacy" Style="{StaticResource LinkButton}" Click="MicrophonePrivacy_Click" />
                            <Button Content="Camera privacy" Style="{StaticResource LinkButton}" Click="CameraPrivacy_Click" />
                            <Button Content="Reset website permissions" Style="{StaticResource LinkButton}" Click="Permissions_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Performance -->
                <TextBlock Text="Performance" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="LowMemoryCheck" AutomationProperties.Name="Background low-memory mode">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource SettingRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AppNotificationsCheck}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                            <StackPanel>
                                <TextBlock Text="Background low-memory mode" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Uses less memory in the tray. Only applies while desktop notifications are off and no call is open." Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <CheckBox x:Name="HardwareCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="Hardware acceleration">
                            <StackPanel>
                                <TextBlock Text="Hardware acceleration" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Uses the GPU for smoother video. Takes effect after Tray &gt; Exit and relaunch." Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="DevToolsCheck" Style="{StaticResource SettingRow}" AutomationProperties.Name="Developer tools">
                            <StackPanel>
                                <TextBlock Text="Developer tools" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Enables F12 and Inspect for troubleshooting." Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}" />
                        <WrapPanel Margin="0,12,0,4">
                            <Button Content="Open assets folder" Style="{StaticResource LinkButton}" Click="Assets_Click" />
                            <Button Content="Open logs" Style="{StaticResource LinkButton}" Click="Logs_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Hidden options kept for settings compatibility -->
                <StackPanel Visibility="Collapsed">
                    <ComboBox x:Name="SidebarModeCombo" AutomationProperties.Name="Sidebar mode"><ComboBoxItem Content="Expanded" /><ComboBoxItem Content="Compact" /></ComboBox>
                    <CheckBox x:Name="CompactLayoutCheck" Content="Compact Instagram layout" />
                    <CheckBox x:Name="CustomizationCheck" Content="UI customization (CSS / JavaScript)" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="Save" Click="Save_Click" IsDefault="True" MinWidth="100" Style="{StaticResource AccentButton}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
