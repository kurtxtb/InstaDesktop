<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>1.3.0</Version>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- This is a WPF entry point. WinForms is used only for NotifyIcon;
         WPF DPI awareness belongs in the manifest, not WinForms startup code. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Product>InstaDesktop</Product>
    <Description>A lightweight desktop window for Instagram Web.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;artifacts/**;.build/**;.nuget/**;tools/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Scripts and fonts are embedded and always match this version; only the
         Twemoji attribution ships as a file. -->
    <Content Include="Assets\Fonts\Twemoji-LICENSE-GRAPHICS.txt" Link="Licenses\Twemoji-LICENSE-GRAPHICS.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- WPF Content pack URIs require Assembly.Location, which is empty in a
         single-file bundle. Embed the window/image icon as a WPF resource. -->
    <Resource Include="Assets\Icons\app.ico" />
    <EmbeddedResource Include="Assets\Scripts\**\*.js;Assets\Fonts\*.woff2" />
  </ItemGroup>
</Project>
